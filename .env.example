# ─── Flower Ordering System - Environment Configuration Template ──────────────
# Copy this file to .env and fill in your values before running docker-compose

# ─── Database ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=flower_root_2024        # Change this!
MYSQL_DATABASE=flower_ordering
MYSQL_USER=flower_user
MYSQL_PASSWORD=flower_pass_2024             # Change this!

# ─── Application ──────────────────────────────────────────────────────────────
# A long random string for signing JWT tokens (staff sessions)
# Generate one with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# Port to expose the app on the host machine (default: 8080)
APP_PORT=8080
